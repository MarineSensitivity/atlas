# atlas-3 / plan D10: the seal and the agency name are BUILD FLAGS, not code -- copy this file to
# `.env` (gitignored) to override them for a local `npm run dev`/`npm run build`. CI
# (.github/workflows/pages.yml) sets VITE_SEAL and VITE_AGENCY directly in the build step's `env:`,
# per the owner's approval (docs/design/spec.md §9): nothing ships with the seal before someone
# with authority says so, and the transition to a different agency is one variable.

# "1" shows the seal (About card, report header, the on-map About card); "0" or unset never does,
# even if VITE_AGENCY is set (fails closed -- src/lib/ui/sealVisibility.ts).
VITE_SEAL=1

# mirrors server/branding/make_branding.py's AGENCY. "MMA" | "BOEM" | "" (empty implies VITE_SEAL
# has no effect: an agency-free seal is not a lockup the brand guide recognizes).
VITE_AGENCY=MMA

# where src/lib/ui/About.svelte lazy-loads the seal image from. Left unset, it defaults to the
# published copy at https://marinesensitivity.org/branding/mma-seal.svg (verified live; see the
# atlas-3 plan's progress log). Override only if that copy moves.
# VITE_SEAL_URL=https://marinesensitivity.org/branding/mma-seal.svg
