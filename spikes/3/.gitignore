# spikes/3: everything under tiles/ is fetched or generated by a committed script, never
# hand-authored -- the 4 locally-built cell_metric tiles (scripts/make_tiles.sql) and the local
# mirror of duckdb-wasm's extension .wasm files (scripts/fetch_extensions.sh). Never commit release
# data or third-party binaries, even a locally-cut/mirrored copy of them.
tiles/

# build/test output (root .gitignore already covers most of this repo-wide, but its
# /playwright-report/ and /test-results/ entries are anchored to the repo root, not here)
dist/
playwright-report/
test-results/
